# Secrets for config/deploy.yml, read through VisiPass: one approval per deploy, and a missing
# or empty secret stops the deploy. No values live in this file.
#
# Keep every line in the plain `NAME=$(kamal secrets extract NAME ${SECRETS})` form. Kamal does
# not run these lines through a shell: anything extra, such as a pipe, becomes an argument, and
# its usage error prints every fetched value to the terminal.
SECRETS=$(vp kamal-fetch --purpose "Deploy VisiConvert engine" --from "op://VisiConvert/Engine" KAMAL_REGISTRY_PASSWORD=op://Varda/Production/GITHUB_TOKEN DATABASE_URL VISICONVERT_API_KEY VISICONVERT_CLOUD_SERVICE_KEY VISICONVERT_ENCRYPTION_KEY VISICONVERT_GOOGLE_CLIENT_ID VISICONVERT_GOOGLE_CLIENT_SECRET VISICONVERT_MICROSOFT_CLIENT_ID VISICONVERT_MICROSOFT_CLIENT_SECRET VISICONVERT_MICROSOFT_DEVELOPER_TOKEN)

KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS})
DATABASE_URL=$(kamal secrets extract DATABASE_URL ${SECRETS})
VISICONVERT_API_KEY=$(kamal secrets extract VISICONVERT_API_KEY ${SECRETS})
VISICONVERT_CLOUD_SERVICE_KEY=$(kamal secrets extract VISICONVERT_CLOUD_SERVICE_KEY ${SECRETS})
VISICONVERT_ENCRYPTION_KEY=$(kamal secrets extract VISICONVERT_ENCRYPTION_KEY ${SECRETS})
VISICONVERT_GOOGLE_CLIENT_ID=$(kamal secrets extract VISICONVERT_GOOGLE_CLIENT_ID ${SECRETS})
VISICONVERT_GOOGLE_CLIENT_SECRET=$(kamal secrets extract VISICONVERT_GOOGLE_CLIENT_SECRET ${SECRETS})
VISICONVERT_MICROSOFT_CLIENT_ID=$(kamal secrets extract VISICONVERT_MICROSOFT_CLIENT_ID ${SECRETS})
VISICONVERT_MICROSOFT_CLIENT_SECRET=$(kamal secrets extract VISICONVERT_MICROSOFT_CLIENT_SECRET ${SECRETS})
VISICONVERT_MICROSOFT_DEVELOPER_TOKEN=$(kamal secrets extract VISICONVERT_MICROSOFT_DEVELOPER_TOKEN ${SECRETS})
